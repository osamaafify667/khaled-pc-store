// Khaled PC Store — Prisma schema
// جميع الأسعار بالجنيه المصري وتُخزَّن بدقة Decimal(12,2)
// المواصفات تُخزَّن كصفوف مفتاحية/قيمة لتسهيل إضافة مواصفات وقواعد جديدة لاحقًا.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  COMPONENT
  PREBUILT
}

enum SpecDataType {
  TEXT
  NUMBER
  BOOLEAN
}

enum StockMovementType {
  ADJUSTMENT
  RESTOCK
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_FULFILL
  IMPORT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  PICKUP_CASH
  INSTAPAY
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  PAID
  REJECTED
  REFUNDED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum CouponType {
  PERCENT
  FIXED
}

enum CompatibilitySeverity {
  INFO
  WARNING
  ERROR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         Session[]
  addresses        Address[]
  orders           Order[]
  carts            Cart[]
  builds           Build[]
  auditLogs        AuditLog[]
  movements        StockMovement[]
  reviewedPayments Payment[]       @relation("PaymentReviewer")

  @@index([role])
  @@index([createdAt])
}

model Session {
  // المعرّف هو SHA-256 للتوكن، ولا يُخزَّن التوكن نفسه أبدًا
  id        String   @id
  userId    String
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  count       Int       @default(0)
  lockedUntil DateTime?
  firstAt     DateTime  @default(now())
  lastAt      DateTime  @default(now())

  @@index([lastAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  recipient   String
  phone       String
  governorate String
  city        String
  area        String?
  street      String
  building    String?
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String
  description String?
  icon        String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Product {
  id              String        @id @default(cuid())
  sku             String        @unique
  slug            String        @unique
  nameAr          String
  nameEn          String?
  model           String?
  descriptionAr   String?
  descriptionEn   String?
  price           Decimal       @db.Decimal(12, 2)
  compareAtPrice  Decimal?      @db.Decimal(12, 2)
  warrantyMonths  Int           @default(0)
  status          ProductStatus @default(DRAFT)
  type            ProductType   @default(COMPONENT)
  isFeatured      Boolean       @default(false)
  hasBox          Boolean       @default(true)
  salesCount      Int           @default(0)
  categoryId      String
  brandId         String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  specs          ProductSpecification[]
  inventory      Inventory?
  orderItems     OrderItem[]
  cartItems      CartItem[]
  buildItems     BuildItem[]
  stockMovements StockMovement[]

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, price])
  @@index([status, createdAt])
  @@index([type, status])
  @@index([isFeatured])
  @@index([model])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductSpecification {
  id           String       @id @default(cuid())
  productId    String
  key          String
  label        String
  value        String
  numericValue Decimal?     @db.Decimal(14, 3)
  unit         String?
  dataType     SpecDataType @default(TEXT)
  group        String?
  sortOrder    Int          @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([key])
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  type           StockMovementType
  quantityChange Int
  balanceAfter   Int
  reason         String?
  reference      String?
  userId         String?
  orderId        String?
  createdAt      DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([userId])
  @@index([orderId])
}

model Cart {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String?
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  accessToken     String          @unique
  userId          String?
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus   @default(PENDING)

  subtotal    Decimal @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  couponCode    String?
  customerName  String
  customerPhone String
  customerEmail String?

  shippingGovernorate String?
  shippingCity        String?
  shippingArea        String?
  shippingStreet      String?
  shippingBuilding    String?
  shippingNotes       String?

  notes          String?
  adminNotes     String?
  cancelReason   String?
  trackingNumber String?
  carrier        String?
  pickupCode     String?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payment   Payment?
  auditLogs AuditLog[]

  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([userId])
  @@index([customerPhone])
  @@index([placedAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  productName   String
  productSku    String
  productSlug   String?
  unitPrice     Decimal @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal @db.Decimal(12, 2)
  specsSnapshot Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  proofUrl        String?
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reviewedById])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(12, 2)
  minSubtotal Decimal    @default(0) @db.Decimal(12, 2)
  maxUses     Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

model Build {
  id         String   @id @default(cuid())
  publicId   String   @unique
  userId     String?
  name       String   @default("تجميعة بدون اسم")
  isSaved    Boolean  @default(false)
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BuildItem[]

  @@index([userId])
  @@index([createdAt])
}

model BuildItem {
  id        String   @id @default(cuid())
  buildId   String
  productId String
  slot      String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  build   Build   @relation(fields: [buildId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buildId, slot])
  @@index([productId])
}

model CompatibilityRule {
  id          String                @id @default(cuid())
  key         String                @unique
  label       String
  description String?
  severity    CompatibilitySeverity @default(WARNING)
  isActive    Boolean               @default(true)
  config      Json?
  updatedAt   DateTime              @updatedAt
}

model ShippingZone {
  id            String   @id @default(cuid())
  governorate   String   @unique
  fee           Decimal  @db.Decimal(12, 2)
  codAvailable  Boolean  @default(true)
  estimatedDays String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model StoreSettings {
  id                    Int      @id @default(1)
  storeNameAr           String   @default("متجر خالد للكمبيوتر")
  storeNameEn           String   @default("KHALED PC STORE")
  tagline               String   @default("قطع كمبيوتر أصلية وتجميعات احترافية")
  storeNote             String?
  phone                 String?
  whatsapp              String?
  email                 String?
  addressLine           String   @default("مول البستان، وسط البلد، القاهرة، مصر")
  workingHours          String?
  mapUrl                String?
  instagramUrl          String?
  facebookUrl           String?
  announcement          String?
  instapayEnabled       Boolean  @default(false)
  instapayHandle        String?
  instapayName          String?
  instapayInstructions  String?
  codEnabled            Boolean  @default(true)
  pickupEnabled         Boolean  @default(true)
  shippingFlatFee       Decimal  @default(0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  lowStockThreshold     Int      @default(3)
  defaultWarrantyMonths Int      @default(12)
  metaTitle             String?
  metaDescription       String?
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}
