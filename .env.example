# ------------------------------------------------------------------
# Khaled PC Store — نموذج متغيرات البيئة (بدون أي أسرار حقيقية)
# انسخ الملف إلى .env ثم عدّل القيم.
# ------------------------------------------------------------------

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/khaled_pc_store?schema=public"
# قاعدة بيانات الاختبارات (تُنشأ تلقائيًا بواسطة scripts/test-setup.ts)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/khaled_pc_store_test?schema=public"

# رابط الموقع العام (يُستخدم في Metadata وSitemap وروابط المشاركة)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------
# إنشاء أول حساب مدير (يُستخدم بواسطة npm run admin:create وprisma seed)
# لا تضع كلمة مرور ثابتة في الإنتاج. اختر كلمة مرور قوية وفريدة.
# ------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="مدير المتجر"

# بيانات تجريبية للتطوير فقط (true في التطوير / false في الإنتاج)
SEED_DEMO_DATA="false"

# ------------------------------------------------------------------
# تخزين الصور
# الوضع الافتراضي: local (يُحفظ داخل public/uploads)
# للإنتاج: s3 مع أي خدمة متوافقة مع S3 (AWS S3 / Cloudflare R2 / MinIO...)
# ------------------------------------------------------------------
STORAGE_DRIVER="local"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"

# ------------------------------------------------------------------
# إعدادات أمنية
# عدد محاولات تسجيل الدخول قبل القفل، ومدة القفل بالدقائق
# ------------------------------------------------------------------
AUTH_MAX_LOGIN_ATTEMPTS="5"
AUTH_LOCK_MINUTES="15"
# مدة جلسة المستخدم بالأيام
AUTH_SESSION_DAYS="30"

# ------------------------------------------------------------------
# (اختياري) خدمة بريد لإشعارات الطلبات — غير مفعّلة في النسخة الأولى
# ------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
