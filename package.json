{
  "name": "khaled-pc-store",
  "version": "1.0.0",
  "private": true,
  "description": "متجر خالد للكمبيوتر — KHALED PC STORE",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "tsx scripts/test-setup.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "dotenv": "18.0.9",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
